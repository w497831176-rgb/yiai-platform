# YIAI Platform environment variables
# Copy this file to .env and replace placeholders with real values.
# NEVER commit real passwords, keys, or tokens to version control.

# Application
NODE_ENV=development
YIAI_PLATFORM_API_PORT=3000

# Database (PostgreSQL 16)
YIAI_PLATFORM_DB_HOST=localhost
YIAI_PLATFORM_DB_PORT=5432
YIAI_PLATFORM_DB_USER=yiai
YIAI_PLATFORM_DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
YIAI_PLATFORM_DB_NAME=yiai_platform

# Alternative: full database URL
# YIAI_PLATFORM_DATABASE_URL=postgresql://yiai:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/yiai_platform

# Security
YIAI_PLATFORM_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Dify (future use only; never expose to frontend)
# YIAI_PLATFORM_DIFY_BASE_URL=https://your-dify-instance.example.com
# YIAI_PLATFORM_DIFY_API_KEY=REPLACE_WITH_DIFY_API_KEY
