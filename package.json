{
  "name": "yiai-platform",
  "version": "0.0.1",
  "private": true,
  "description": "YIAI Platform - Dify Chatflow aggregation platform for C-end users",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "db:migrate": "node db/migrations/migrate.js",
    "db:migrate:test": "cross-env NODE_ENV=test node db/migrations/migrate.js",
    "admin:create": "node scripts/create-admin.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "pg": "^8.14.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
