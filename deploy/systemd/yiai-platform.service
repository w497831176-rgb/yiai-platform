[Unit]
Description=YIAI Platform Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/yiai-platform/current
ExecStart=/usr/bin/docker compose --env-file /srv/yiai-platform/secrets/.env -f compose.ubuntu.yml up -d --no-build
ExecStop=/usr/bin/docker compose --env-file /srv/yiai-platform/secrets/.env -f compose.ubuntu.yml stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
